<resources>
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="android:fontFamily">@font/myriadpro_regular</item>
        <item name="fontFamily">@font/myriadpro_regular</item>

        <item name="android:windowBackground">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:textColorTertiary">#FFFFFF</item>

        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="actionBarSize">33dp</item>
    </style>

    <style name="MyActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="height">32dp</item>
        <item name="titleTextStyle">@style/MyActionBarTitle</item>
    </style>

    <style name="MyActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:fontFamily">@font/montserrat_black</item>
        <item name="fontFamily">@font/montserrat_black</item>
    </style>
</resources>